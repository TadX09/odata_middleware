          "// Set default headers for all requests",
          "pm.request.headers.add({\n    key: 'Content-Type',\n    value: 'application/json'\n});",
          "pm.request.headers.add({\n    key: 'Accept',\n    value: 'application/json'\n});"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Basic response validation",
          "pm.test(\"Status code is 200\", function () {",
          "    pm.response.to.have.status(200);",
          "});",
          "",
          "pm.test(\"Response has data property\", function () {",
          "    const jsonData = pm.response.json();",
          "    pm.expect(jsonData).to.have.property('data');",
          "});",
          "",
          "pm.test(\"Response has metadata property\", function () {",
          "    const jsonData = pm.response.json();",
          "    pm.expect(jsonData).to.have.property('metadata');",
          "});",
          "",
          "// Store generated URL for workflow testing",
          "if (pm.response.json().data && pm.response.json().data.odata_url) {",
          "    pm.environment.set('generated_url', pm.response.json().data.odata_url);",
          "}"
